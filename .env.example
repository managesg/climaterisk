# SeaBridge AI Sustainability Toolkit — Environment Variables
# Copy this file to .env and fill in your values.

# MongoDB connection
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=seabridge

# Anthropic API key (required for AI agents)
ANTHROPIC_API_KEY=

# Mapbox token (required for frontend map)
MAPBOX_TOKEN=

# Set to true to enable live calls to external data APIs
# When false (default) all providers return stub data — safe for development
ENABLE_LIVE_DATA=false

# NASA Earthdata token (NASA FIRMS, NEX-GDDP)
NASA_EARTHDATA_TOKEN=

# IUCN Red List API key
IUCN_API_KEY=

# physrisk Zarr store (S3 URL for OS-Climate hazard data)
# Leave blank to skip physrisk bridge supplemental features
PHYSRISK_ZARR_STORE=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
