FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY requirements-toolkit.txt .
RUN pip install --no-cache-dir -r requirements-toolkit.txt

# src/ is volume-mounted in dev; copy here so the image works standalone too
COPY src/ ./src/

ENV PYTHONPATH=/app/src

EXPOSE 8000
